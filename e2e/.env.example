# Credentials used by tests/dashboard/*.spec.ts (and the dashboard-style
# auth spec under tests/frontend/). The dashboard's "/admin/auth/login"
# endpoint only accepts users with role TENANT_ADMIN or SYSTEM_ADMIN.
# The seed script (api/prisma/seed.ts) only creates a SYSTEM_ADMIN user,
# so that account is used here.
E2E_TENANT_EMAIL=
E2E_TENANT_PASSWORD=

# Credentials used by tests/frontend/wallet-transfer.spec.ts. This is the
# CUSTOMER user created for "Test Tenant" by api/prisma/seed.ts and logs in
# via the regular "/auth/login" endpoint.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Account number of a second wallet belonging to the same tenant as
# E2E_USER_EMAIL — used as the transfer recipient in wallet-transfer.spec.ts.
# The seed script only creates one wallet for this user, so before running
# the transfer test:
#   1. Log in to the frontend as E2E_USER_EMAIL
#   2. Create a second wallet (any other currency)
#   3. Copy its account number here
E2E_RECIPIENT_ACCOUNT_NUMBER=
